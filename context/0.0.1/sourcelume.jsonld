{
  "@context": {
    "sourcelume": "https://sourcelume.apache.org/ns#",
    "dct": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "spdx": "http://spdx.org/rdf/terms#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",

    "ProvenanceRecord": "sourcelume:ProvenanceRecord",

    "identifier": "dct:identifier",
    "name": "schema:name",
    "version": "schema:version",
    "license": {
      "@id": "dct:license",
      "@type": "@id"
    },
    "creator": "schema:creator",
    "role": "sourcelume:role",
    "created": {
      "@id": "dct:created",
      "@type": "xsd:dateTime"
    },
    "origin": "sourcelume:origin",
    "custodyChain": "sourcelume:custodyChain",
    "agent": {
      "@id": "schema:agent",
      "@type": "@id"
    },
    "action": "sourcelume:action",
    "startTime": {
      "@id": "schema:startTime",
      "@type": "xsd:dateTime"
    }
  }
}
