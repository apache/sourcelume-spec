    {
      "type": "schema:Organization",
      "name": "BigScience workshop Data Sourcing working group — selected the code languages (same selection as AlphaCode), deduplicated, and filtered for length and alphabetic-character ratios",
      "role": "curator"
    },
    {
      "type": "schema:Organization",
      "name": "BigScience workshop — published ROOTS as a gated release subject to the BigScience ethical charter",
